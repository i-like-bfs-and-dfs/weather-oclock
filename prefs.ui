<?xml version="1.0" encoding="UTF-8"?>
<interface domain="weatheroclock">
  <object class="AdwPreferencesPage" id="MainWidget">
    <property name="title" translatable="yes">Preferences</property>
    <property name="valign">start</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">General</property>
        <child>
          <object class="AdwComboRow" id="TemperatureUnit">
            <property name="title" translatable="yes">Temperature Unit</property>
            <property name="model">
              <object class="GtkStringList">
                <items>
                  <item translatable="yes">System Default</item>
                  <item translatable="yes">Celsius (°C)</item>
                  <item translatable="yes">Fahrenheit (°F)</item>
                  <item translatable="yes">Kelvin (K)</item>
                </items>
              </object>
            </property>
          </object>
        </child>
        <child>
          <object class="AdwActionRow">
            <property name="title" translatable="yes">Weather After Clock</property>
            <property name="subtitle" translatable="yes">Widget to the right of the clock</property>
            <property name="activatable-widget">WeatherAfterClock</property>
            <child>
              <object class="GtkSwitch" id="WeatherAfterClock">
                <property name="valign">center</property>
                <property name="active">False</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
